#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Save a unit's radio calibration (its MT7996 EEPROM image) from its NAND backup.

init/install does this itself. Run it directly for a backup taken elsewhere:

    init/eeprom --unit SERIAL [--backup FILE]

The image goes to the unit's directory as eeprom.bin, where the host tools
find it.
"""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initkit import backup, config                     # noqa: E402
from initkit.console import StepFailed                 # noqa: E402


def main():
    settings = config.load()
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--unit', metavar='SERIAL', required=True)
    parser.add_argument('--data-dir', type=Path, default=Path(settings['data_dir']))
    parser.add_argument('--backup', metavar='FILE', type=Path,
                        help='a NAND backup (default: the one in the unit directory)')
    args = parser.parse_args()
    if not backup.SERIAL_FORM.match(args.unit):
        parser.error('--unit must be the unit serial')
    directory = config.unit_dir(args.data_dir, args.unit)
    source = args.backup or directory / backup.BACKUP_NAME
    try:
        if backup.serial_in_backup(source) != args.unit:
            sys.exit(f'eeprom: {source} is not the backup of {args.unit}')
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        print(f'eeprom: {backup.extract_eeprom(source, directory)}')
    except (OSError, StepFailed) as error:
        sys.exit(f'eeprom: {error}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
