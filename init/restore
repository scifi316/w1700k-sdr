#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Return an installed unit to its stock operating state from its backup.

    init/restore                       # the backup init/install took of the connected unit
    init/restore --unit SERIAL         # the same, and stop unless the unit is SERIAL
    init/restore --backup FILE         # another backup of the connected unit
    init/restore --backup FILE --force # another unit's, or with a damaged calibration

Stock U-Boot boots the restorer from RAM (our installed loader is not needed).
The restorer receives the backup, compares it with the NAND block by block, and
rewrites only the blocks that differ, through the vendor bad-block tables; the
unit then boots its stock firmware. The unit must be the backup's, and the
vendor boot stages and calibration (never written) must still match it. Run
`make` first. See init/README.md.
"""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from initkit import config, nand, restore, session    # noqa: E402
from initkit.console import StepFailed                # noqa: E402


def main():
    settings = config.load()
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    config.add_arguments(parser, settings)
    parser.add_argument('--unit', metavar='SERIAL',
                        help='expect this unit (default: whichever is connected; the restorer '
                             'reads its serial)')
    parser.add_argument('--backup', metavar='FILE', type=Path,
                        help="restore this backup (default: init/install's backup of the unit)")
    parser.add_argument('--force', action='store_true',
                        help="restore even when the unit's serial, boot stages or "
                             'calibration differ from the backup (those are never written)')
    parser.add_argument('--no-boot', action='store_true',
                        help='stay at the restorer prompt afterwards')
    parser.add_argument(nand.UNTESTED_FLAG, dest='accept_untested', action='store_true',
                        help='write a NAND part this project has never run on a unit '
                             '(the W25N04LV), at the risk of corrupting it')
    args = parser.parse_args()
    settings = session.settings_from(args)
    try:
        return restore.run(settings, args.backup, args.unit, boot=not args.no_boot,
                           force=args.force, accept_untested=args.accept_untested)
    except (StepFailed, RuntimeError) as error:
        sys.exit(f'restore: {error}')
    except KeyboardInterrupt:
        sys.exit('restore: interrupted')


if __name__ == '__main__':
    sys.exit(main())
