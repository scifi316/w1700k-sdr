ipaddr=192.168.1.1
serverip=192.168.1.10
loadaddr=0x81800000
bootfile=w1700k-system.itb
fitfile=w1700k-system.itb
rootfsfile=rootfs.squashfs
bootargs=console=ttyS0,115200 earlycon panic=5 ro rdinit=/init ubi.mtd=system ubi.block=0,rootfs
verify=yes
autostart=no
bootpart=system
bootvol=fit
bootconf=conf-sdr
bootlimit=1
bootcmd=ubi part.ro ${bootpart} && ubi read ${loadaddr} ${bootvol} && iminfo ${loadaddr} && bootm ${loadaddr}#${bootconf}
altbootcmd=echo *** boot limit exceeded, stopping at prompt ***
boot_tftp=tftpboot ${loadaddr} ${bootfile} && iminfo ${loadaddr} && bootm ${loadaddr}#${bootconf}
update_fit=tftpboot ${loadaddr} ${fitfile} && ubi part.rw ${bootpart} && ubi write ${loadaddr} fit ${filesize}
update_rootfs=tftpboot ${loadaddr} ${rootfsfile} && ubi part.rw ${bootpart} && ubi write ${loadaddr} rootfs ${filesize}
bootm_low=0x80000000
bootm_size=0x80000000
bootm_mapsize=0x80000000
fdt_high=0x84000000
